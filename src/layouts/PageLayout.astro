---
import AIWidget from '@components/AIWidget.astro'
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
const { title, description, image, ogType, publishedTime, structuredData } = Astro.props
import { SITE } from "@consts"

const pageTitle = title === SITE.TITLE ? title : `${title} | ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} image={image} ogType={ogType} publishedTime={publishedTime} structuredData={structuredData} />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
    <AIWidget />
  </body>
</html>
